# Required: generate a long random token and use the same value in the Go client.
BROWSER_USE_SIDECAR_TOKEN=replace-with-a-long-random-token

# Compose and run.sh.
BROWSER_USE_COMPOSE_PROJECT=agentize-browser-use
BROWSER_USE_IMAGE_NAME=agentize-browser-use:local
BROWSER_USE_BIND_ADDRESS=127.0.0.1
BROWSER_USE_PORT=8087
BROWSER_USE_STARTUP_TIMEOUT_SECONDS=240
BROWSER_USE_AUTO_START_DOCKER=true

# Base image mirror used by Docker build.
BROWSER_USE_PYTHON_IMAGE=docker.arvancloud.ir/library/python:3.12-slim
BROWSER_USE_DEBIAN_MIRROR=https://archive.debian.petiak.ir/debian
BROWSER_USE_DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

# browser-use's own agent model. Supported values:
# openai | browser-use | openrouter | anthropic | google
BROWSER_USE_LLM_PROVIDER=openai
BROWSER_USE_LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=replace-me
# BROWSER_USE_API_KEY=replace-me
# OPENROUTER_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me

# Optional for OpenAI-compatible gateways.
# BROWSER_USE_LLM_BASE_URL=https://api.openai.com/v1

# Runtime and policy.
BROWSER_USE_MAX_CONCURRENT_JOBS=2
BROWSER_USE_MAX_STEPS=50
BROWSER_USE_JOB_TIMEOUT_SECONDS=600
BROWSER_USE_JOB_TTL_SECONDS=3600
BROWSER_USE_TAB_TTL_SECONDS=900
BROWSER_USE_MAX_JOBS=1000
BROWSER_USE_HEADLESS=true
BROWSER_USE_DEFAULT_USE_VISION=true
BROWSER_USE_CHROMIUM_SANDBOX=false
BROWSER_USE_BLOCK_IP_ADDRESSES=true

# Optional Chromium proxy. This value takes precedence over http_proxy and
# HTTP_PROXY. When omitted, browser-use automatically uses http_proxy first.
# BROWSER_USE_PROXY_URL=http://proxy.example:8080
# http_proxy=http://proxy.example:8080

# Recommended in production. When set, this operator allowlist overrides any
# allowed_domains supplied by a tool call.
# BROWSER_USE_ALLOWED_DOMAINS=example.com,*.example.com
# BROWSER_USE_PROHIBITED_DOMAINS=accounts.google.com
